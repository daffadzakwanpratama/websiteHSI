# =============================================================================
# GESID HALAL CENTER — APACHE SECURITY HARDENING (.htaccess)
# Optimized for Hostinger Shared Hosting (Apache)
# =============================================================================

# ── 1. FORCE HTTPS (SSL) ──────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. FORCE WWW → NON-WWW (pilih salah satu sesuai domain utama) ─────────────
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── 3. HTTP SECURITY HEADERS ──────────────────────────────────────────────────
<IfModule mod_headers.c>

  # Prevent Clickjacking — halaman tidak bisa di-embed di iframe pihak lain
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS Filter di browser lama
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy — batasi info referrer yang dikirim ke situs lain
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy — matikan fitur browser yang tidak dipakai
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy (CSP) — whitelist sumber konten yang diizinkan
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.whatsapp.com"

  # HTTP Strict Transport Security (HSTS) — paksa HTTPS selama 1 tahun
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Remove server signature headers yang bocorkan info server
  Header unset Server
  Header unset X-Powered-By
  Header always unset X-Powered-By

</IfModule>

# ── 4. SEMBUNYIKAN INFO SERVER ────────────────────────────────────────────────
ServerSignature Off

# Matikan directory listing — jangan tampilkan isi folder
Options -Indexes

# ── 5. BLOKIR AKSES KE FILE SENSITIF ─────────────────────────────────────────
<FilesMatch "(^\.htaccess|\.htpasswd|\.git|\.env|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|README\.md|PRD\.md)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Blokir akses ke folder .git
<IfModule mod_rewrite.c>
  RewriteRule ^\.git - [F,L]
  RewriteRule ^node_modules - [F,L]
  RewriteRule ^src/ - [F,L]
  RewriteRule ^\.gitignore - [F,L]
</IfModule>

# ── 6. BLOKIR AKSES KE FILE BACKUP / TEMP ────────────────────────────────────
<FilesMatch "\.(bak|old|orig|save|swp|tmp|log|sql|sh|py|rb|conf|ini|cfg)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ── 7. BLOKIR USER AGENT BERBAHAYA (Bad Bots & Scanners) ─────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|nessus|burpsuite|acunetix|ZmEu|w3af|dirbuster|Havij|libwww-perl|python-requests/2\.2|python-urllib) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ── 8. ANTI-HOTLINKING GAMBAR ─────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https://(www\.)?gesidhalalcenter\.com [NC]
  RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico)$ - [F,NC]
</IfModule>

# ── 9. BROWSER CACHING (PERFORMANCE + SECURITY) ───────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — cache pendek agar update cepat terlihat
  ExpiresByType text/html                "access plus 1 hour"

  # CSS & JS
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"

  # Fonts
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType font/woff                "access plus 1 year"

  # Images
  ExpiresByType image/jpeg               "access plus 6 months"
  ExpiresByType image/png                "access plus 6 months"
  ExpiresByType image/webp               "access plus 6 months"
  ExpiresByType image/svg+xml            "access plus 6 months"
  ExpiresByType image/x-icon             "access plus 1 year"
</IfModule>

# ── 10. CUSTOM ERROR PAGES ───────────────────────────────────────────────────
# ErrorDocument 403 /403.html
# ErrorDocument 404 /404.html

# ── 11. DISABLE HTTP METHODS BERBAHAYA ───────────────────────────────────────
<LimitExcept GET POST HEAD>
  Order Allow,Deny
  Deny from all
</LimitExcept>

# ── 12. COMPRESS RESPONSE (GZIP) ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain image/svg+xml
</IfModule>
